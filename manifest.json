{
  "manifest_version": 3,
  "name": "AX-Privacy",
  "version": "3.2.6",
  "description": "Gelişmiş reklam engelleme, URL izleyici temizleyici, yerel tehdit kalkanı, Twitch SSAI, YouTube video kalkanı, pop-up/yönlendirme engelleme ve özel filtre listesi yöneticisi.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "AX-Privacy",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "popup-shield.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://*.twitch.tv/*",
        "https://twitch.tv/*"
      ],
      "js": [
        "twitch-shield.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": [
        "youtube-shield.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_ads",
        "enabled": true,
        "path": "rules/ads_trackers.json"
      },
      {
        "id": "ruleset_url_clean",
        "enabled": true,
        "path": "rules/url_clean.json"
      },
      {
        "id": "ruleset_popups",
        "enabled": true,
        "path": "rules/popups_redirects.json"
      }
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  }
}
