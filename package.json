{
  "name": "ax-privacy",
  "version": "0.14.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "pack": "node scripts/pack.ts",
    "filters": "node scripts/filters.ts",
    "release": "npm run filters && npm run build && npm run check && npm run pack",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:firefox": "node e2e/firefox.ts",
    "live-check": "node e2e/live-check.ts",
    "sites": "node e2e/site-check.ts",
    "resource-check": "node e2e/resource-check.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@duckduckgo/autoconsent": "^17.2.0",
    "@ghostery/adblocker": "^2.20.3",
    "@ghostery/adblocker-content": "^2.20.3",
    "@ghostery/adblocker-extended-selectors": "^2.20.3",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tldts": "^7.4.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
