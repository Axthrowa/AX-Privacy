{
  "name": "ax-privacy",
  "version": "5.1.0",
  "description": "Gelişmiş reklam engelleme, AX-Brain yerel öğrenen kalkan, URL izleyici temizleyici, yerel tehdit kalkanı, Twitch SSAI, YouTube kalkanı ve kırılmaz pop-up koruması.",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "build": "node scripts/build.ts",
    "pack": "node scripts/pack.ts",
    "filters": "node scripts/filters.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test --project brave",
    "e2e:chromium": "playwright test --project chromium",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "release": "npm run filters && npm run build && npm run check && npm run pack",
    "filters:offline": "node scripts/filters.ts --offline",
    "brands": "node scripts/brands.ts",
    "repro": "node scripts/repro.ts"
  },
  "dependencies": {
    "@duckduckgo/autoconsent": "^17.2.0",
    "@ghostery/adblocker": "^2.20.3",
    "@ghostery/adblocker-content": "^2.20.3",
    "@ghostery/adblocker-extended-selectors": "^2.20.3",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tldts": "^7.4.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
